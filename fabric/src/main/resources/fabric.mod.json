{
    "schemaVersion": 1,
    "id": "hidearmor",
    "version": "${version}",
    "name": "Hide Your Armor",
    "description": "Client-side utility for granular armor, shield, and elytra visibility control with opacity sliders.",
    "authors": ["G10W5"],
    "license": "MIT",
    "environment": "*",
    "entrypoints": {
        "main": ["com.example.hidearmor.fabric.HideArmorFabric"],
        "client": ["com.example.hidearmor.fabric.HideArmorFabricClient"]
    },
    "mixins": [
        "hidearmor.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=0.19.3",
        "minecraft": ">=26.2",
        "java": ">=25",
        "fabric-api": "*"
    }
}
